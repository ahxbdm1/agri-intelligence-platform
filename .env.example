ENVIRONMENT=development
SECRET_KEY=please-change-this-secret
DATABASE_URL=sqlite:///./agri_intelligence.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MOCK_DISEASE_MODEL=false
DISEASE_MODEL_PROVIDER=ip102
PEST_YOLO_MODEL_PATH=data/generated/models/ip102_pest_yolo_best.pt
SEED_DEMO_DATA_ON_STARTUP=true

# PostgreSQL Docker profile
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri_pass
POSTGRES_DB=agri_intelligence

# Optional LLM provider keys for production RAG generation
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional RAGFlow remote knowledge base. Keep real credentials in .env only.
RAGFLOW_ENABLED=false
RAGFLOW_BASE_URL=http://your-ragflow-host
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
RAGFLOW_CHAT_ID=
RAGFLOW_TIMEOUT_SECONDS=35
RAGFLOW_STATUS_TIMEOUT_SECONDS=12
AGRI_DEMO_BASE_DATE=2026-05-06
RAGFLOW_VERIFY_SSL=true
